# Local development defaults. Copy to backend/.env — never commit the copy.
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://pulse:pulse_dev_123@localhost:5432/job_market_pulse
REDIS_URL=redis://localhost:6379/0
SCRAPE_INTERVAL_HOURS=6

# Browser origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Shared secret for POST /api/v1/pipeline/run, sent as the X-Pipeline-Token
# header. Optional locally (the endpoint stays open against localhost);
# REQUIRED in production — the app refuses to start without it, because a
# public unauthenticated trigger fans out to 19 external job boards.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PIPELINE_TOKEN=

# ── Production (e.g. Railway) ────────────────────────────────────────
# ENVIRONMENT=production
# DATABASE_URL is injected by the Postgres add-on. `postgres://` and
# `postgresql://` are rewritten to `postgresql+asyncpg://` automatically.
# REDIS_URL is injected by the Redis add-on.
# CORS_ORIGINS=https://your-dashboard.vercel.app
# PIPELINE_TOKEN=<a long random string>
