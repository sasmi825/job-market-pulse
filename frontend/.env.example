# Copy to frontend/.env.local for local development.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, not
# read at runtime — so this must be set before `next build`, and changing it
# later requires a rebuild/redeploy, not just a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Production (set in the Vercel project's Environment Variables):
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app/api/v1
